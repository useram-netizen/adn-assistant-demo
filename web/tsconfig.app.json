{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@adn/copy": ["../server/src/config/copy.ts"],
      "@adn/taxonomy": ["../server/src/config/taxonomy.ts"],
      "@adn/api": ["../server/src/shared/api.ts"]
    },
    "noEmit": true
  },
  "include": ["src", "test"]
}
