# ADN Professional Matcher settings.
# Copy this file to .env (in the repo root) and fill it in. Never commit .env: it holds secrets.
# Leave a value empty to use its default. Values marked OPEN are agreed defaults, not final decisions.
# Each setting is checked when the server starts; a bad value stops it with a clear message.
# Put a value in quotes if it contains "#" (otherwise everything after "#" is a comment).
#
# On Render, only OPENAI_API_KEY is needed: everything else has a working default.

# ---------------------------------------------------------------- Server
# production on the live server (allows EMAIL_MODE=live). development otherwise.
NODE_ENV=development
PORT=3000
# The public address of this server: scheme and host only, no path or trailing slash.
# Empty = RENDER_EXTERNAL_URL (which Render sets automatically), else http://localhost:PORT.
# It must be https in production, because the host sites are https.
PUBLIC_BASE_URL=
# Which proxies to trust for the visitor's IP (rate limits). Empty = automatic:
# Render's proxy on Render, otherwise only a proxy on this machine ("loopback").
TRUST_PROXY=

# ---------------------------------------------------------------- Members
# The member list, loaded into memory at startup and re-read every 10 minutes.
# To update it, replace the file and push (Render redeploys). .csv or .xlsx.
MEMBERS_FILE=data/members.csv
# Manual decisions by email, for example { "x@y.com": { "exclude": true, "reason": "…" } }.
MEMBER_OVERRIDES_FILE=data/member-overrides.json

# ---------------------------------------------------------------- Storage (leads, gaps, events)
# Optional. Empty = JSON files in STORAGE_DIR (on Render they reset with each deploy).
# If MongoDB is set but unreachable, writes fall back to the files; nothing crashes.
MONGODB_URI=
MONGODB_DB=adn_matcher
STORAGE_DIR=.data

# ---------------------------------------------------------------- AI
OPENAI_API_KEY=
# Default model (checked: available on this account). Also seen: gpt-6-astra, gpt-6-sol.
OPENAI_MODEL=gpt-6-luna
# Only for tests or a proxy; empty = the OpenAI API.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=10000
# false = buttons only (typed text still gets the safety check and exact matches).
AI_ENABLED=true
MAX_AI_CALLS_PER_SESSION=20
# Not implemented: what visitors type is never stored. Leave it false.
STORE_TRANSCRIPTS=false

# ---------------------------------------------------------------- Email
# preview = nothing is sent; emails are saved as HTML in MAIL_PREVIEW_DIR (the default).
# redirect = everything goes to EMAIL_REDIRECT_TO instead of the real recipients.
# live = real sending to professionals. Only allowed with NODE_ENV=production.
# redirect and live also need SMTP_HOST and EMAIL_FROM; live needs TRACY_EMAIL too.
EMAIL_MODE=preview
EMAIL_REDIRECT_TO=
MAIL_PREVIEW_DIR=server/.mail-preview
SMTP_HOST=
# 587 = STARTTLS, 465 = TLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sending address and domain are OPEN.
EMAIL_FROM=
# OPEN: whether Tracy gets a copy of every lead. Empty = no copy.
LEAD_COPY_TO=
# OPEN: Tracy's email address for the "Email Tracy" form.
TRACY_EMAIL=

# ---------------------------------------------------------------- Admin
# A long random string (at least 24 characters, for example `openssl rand -hex 24`) for
# GET /api/admin/stats and /api/admin/gaps.csv.
# Empty = admin routes are disabled.
ADMIN_TOKEN=

# ---------------------------------------------------------------- Embedding
# Sites allowed to show the widget in an iframe (CSP frame-ancestors on /widget),
# separated by spaces. This server itself is always allowed.
# * allows any site (used for the first GrowthZone test); narrow it before launch.
ALLOWED_EMBED_ORIGINS=https://divorceamicably.com https://www.divorceamicably.com https://amicabledivorce.net https://www.amicabledivorce.net http://localhost:*

# ---------------------------------------------------------------- Links (OPEN; empty links are hidden)
JOIN_URL=
UK_SITE_URL=https://amicabledivorcenetwork.co.uk
ARTICLES_URL=
PODCAST_URL=
# Book a call with Kristy
BOOKING_URL=
PRIVACY_URL=

# ---------------------------------------------------------------- Display and privacy (OPEN)
# Show professionals' email on result cards.
SHOW_PRO_CONTACT=false
# Days to keep leads. Empty = keep them.
LEAD_RETENTION_DAYS=

# ---------------------------------------------------------------- Testing only
# off = no rate limits (the end-to-end tests run many sessions from one address).
RATE_LIMITS=
