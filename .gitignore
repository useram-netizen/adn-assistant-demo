# Dependencies and builds
node_modules/
dist/
coverage/
*.tsbuildinfo

# Secrets: only .env.example is committed (spec rule 5)
.env
.env.*
!.env.example

# Leads, gaps and events saved as JSON files when MONGODB_URI is not set (STORAGE_DIR).
# They contain visitors' contact details: never commit them.
.data/

# Email previews written in EMAIL_MODE=preview
server/.mail-preview/

# Playwright output
web/playwright-report/
web/test-results/
web/blob-report/

# OS and editor files
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea/
